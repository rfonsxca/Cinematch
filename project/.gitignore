# Excluir artefactos Python, segredos locais e dados gerados durante execução e testes.
__pycache__/
*.pyc
.env
data/
*.sqlite*
tmp*/

# Infraestrutura: estado do Terraform, inventário gerado e credenciais nunca vão para o Git.
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
infra/ansible/inventory.ini
*-key.json
key.json
.gcp/
tfplan
